PORT=3000
# DATABASE_URL: String de conexão PostgreSQL (ex: Supabase, Render PostgreSQL ou local)
# Exemplo Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Exemplo Render: postgresql://[user]:[password]@[host].oregon-postgres.render.com/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devshowcase?schema=public"
NODE_ENV=development
