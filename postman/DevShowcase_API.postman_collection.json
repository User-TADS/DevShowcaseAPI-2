		{
			"name": "2. Novos Endpoints da Etapa Final",
			"item": [
				{
					"name": "2.1. PUT - Incrementar Upvote (Curtidas/Estrelas)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Upvotes incrementado', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.upvotes).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{createdProjectId}}/upvote",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{createdProjectId}}", "upvote"]
						},
						"description": "Incrementa atomicamente em +1 as curtidas/estrelas (upvotes) do projeto no banco de dados."
					},
					"response": []
				},
				{
					"name": "2.2. POST - Cadastrar Feedback 1 (Nota 5 - Recalcula Média)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Média atualizada para 5', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.projectAverageRating).to.eql(5);",
									"});"
								],
								"type": "text/javascript"
							}
						}
