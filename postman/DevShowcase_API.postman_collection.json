									"    pm.expect(jsonData.data).to.have.property('averageRating');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{createdProjectId}}",
