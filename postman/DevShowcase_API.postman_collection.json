								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"author\": \"Comunidade Open Source\",\n  \"content\": \"Código limpo, documentação Swagger interativa e excelente tratamento de exceções!\",\n  \"rating\": 4\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/{{createdProjectId}}/feedbacks",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{createdProjectId}}", "feedbacks"]
						},
						"description": "Cadastra segundo feedback com nota 4. A camada de serviço calcula e atualiza averageRating = (5 + 4) / 2 = 4.5."
					},
					"response": []
				},
				{
					"name": "2.4. GET - Buscar Projetos (Filtro por Tecnologia e Paginação)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Retorna estrutura de paginação', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.pagination).to.have.property('total');",
									"    pm.expect(jsonData.pagination).to.have.property('page');",
									"    pm.expect(jsonData.pagination).to.have.property('limit');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects?technology=Node.js&page=1&limit=5",
							"host": ["{{baseUrl}}"],
							"path": ["projects"],
							"query": [
								{
									"key": "technology",
									"value": "Node.js",
									"description": "Filtro por tecnologia utilizada"
								},
								{
									"key": "page",
									"value": "1",
									"description": "Número da página"
								},
								{
									"key": "limit",
									"value": "5",
									"description": "Limite de itens por página"
								}
							]
						},
						"description": "Busca projetos aplicando filtro por tecnologia (Node.js) e controle de paginação (page=1, limit=5)."
					},
					"response": []
				},
				{
					"name": "2.5. GET - Buscar Projeto por ID (Com Média e Upvotes)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
