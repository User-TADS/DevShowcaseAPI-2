					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"author\": \"Prof. Avaliador\",\n  \"content\": \"Excelente arquitetura em camadas de serviço, tipagem e deploy contínuo!\",\n  \"rating\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/{{createdProjectId}}/feedbacks",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{createdProjectId}}", "feedbacks"]
						},
						"description": "Cadastra o primeiro feedback com nota 5. A camada de serviço calcula e atualiza averageRating = 5.0."
					},
					"response": []
				},
				{
					"name": "2.3. POST - Cadastrar Feedback 2 (Nota 4 - Recalcula Média para 4.5)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code é 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test('Média atualizada para 4.5', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.projectAverageRating).to.eql(4.5);",
									"});"
